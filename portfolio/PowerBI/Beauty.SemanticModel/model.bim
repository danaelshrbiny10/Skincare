        "lineageTag": "347a43d9-f2c7-44cc-8f75-33104136bd9d",
        "measures": [
          {
            "name": "Products",
            "expression": "COUNTROWS(Products)",
            "formatString": "#,0",
            "lineageTag": "de8b8c7c-6603-424b-ab76-56ac7aa20cae"
          },
          {
            "name": "Brands",
            "expression": "DISTINCTCOUNT(Products[Brand])",
            "formatString": "#,0",
            "lineageTag": "887b48de-6f75-408e-a518-7f9412865813"
          },
          {
            "name": "Avg ingredients",
            "expression": "AVERAGE(Products[Ingredient count])",
            "formatString": "0.0",
            "lineageTag": "069f500d-d224-4e70-920c-dc512a90352c"
          },
          {
            "name": "Alcohol-free tagged %",
            "expression": "DIVIDE(CALCULATE([Products], KEEPFILTERS(Products[Alcohol tag] = \"Tagged alcohol-free\")), [Products])",
            "formatString": "0.0%",
            "lineageTag": "8244b123-8ad0-47ae-a848-916c69aea04a"
          },
          {
            "name": "Fragrance-free tagged %",
            "expression": "DIVIDE(CALCULATE([Products], KEEPFILTERS(Products[Fragrance tag] = \"Tagged fragrance / essential oil-free\")), [Products])",
            "formatString": "0.0%",
            "lineageTag": "046a2478-c4bf-4f6b-8b07-4459e5eac25f"
          },
          {
            "name": "Ingredient entries",
            "expression": "COUNTROWS('Ingredient occurrences')",
            "formatString": "#,0",
            "lineageTag": "6d2890a5-d4f1-4242-aa92-46af16703a69"
          },
          {
            "name": "Ingredient product reach",
            "expression": "DISTINCTCOUNT('Ingredient occurrences'[Product ID])",
            "formatString": "#,0",
            "lineageTag": "1b17178d-5b66-495f-925b-c41cb3ade2ce"
          },
          {
            "name": "Distinct ingredients",
            "expression": "DISTINCTCOUNT('Ingredient occurrences'[Ingredient ID])",
            "formatString": "#,0",
            "lineageTag": "a40f99cf-0ceb-4217-b250-a23a0e3cd082"
          },
          {
            "name": "Function product reach",
            "expression": "DISTINCTCOUNT('Product functions'[Product ID])",
            "formatString": "#,0",
            "lineageTag": "14c9b517-310c-4b56-9c66-64fe3e80ef11"
          },
          {
            "name": "Rated entries %",
            "expression": "DIVIDE(CALCULATE([Ingredient entries], KEEPFILTERS('Ingredient occurrences'[Source rating] <> \"Unrated\")), [Ingredient entries])",
            "formatString": "0.0%",
            "lineageTag": "9f5e937b-d464-4f54-8fe2-d2430aa8861d"
          },
          {
            "name": "Name review records",
            "expression": "CALCULATE([Products], KEEPFILTERS(Products[Name review] = \"Review repeated name\"))",
            "formatString": "#,0",
            "lineageTag": "84a87729-e33a-4261-88b3-b165ff5c009b"
          },
          {
            "name": "Image coverage %",
            "expression": "DIVIDE(CALCULATE([Products], KEEPFILTERS(Products[Image available] = \"Available\")),[Products])",
            "formatString": "0.0%",
            "lineageTag": "0380f7fd-6c14-4560-b830-e6761ef649e6"
          },
          {
            "name": "Top brand products",
            "expression": "IF(RANKX(ALLSELECTED(Products[Brand]), [Products], , DESC, DENSE) <= 10, [Products])",
            "formatString": "#,0",
            "lineageTag": "2b92d575-2f72-429c-946f-8d9259cb4134"
          },
          {
            "name": "Top ingredient reach",
            "expression": "IF(RANKX(ALLSELECTED(Ingredients[Ingredient]), [Ingredient product reach], , DESC, DENSE) <= 12, [Ingredient product reach])",
            "formatString": "#,0",
            "lineageTag": "4bba4cec-220f-4891-90cb-aa21a86afb44"
          },
          {
            "name": "Top function reach",
            "expression": "IF(RANKX(ALLSELECTED('Product functions'[Function]), [Function product reach], , DESC, DENSE) <= 10, [Function product reach])",
            "formatString": "#,0",
            "lineageTag": "53076c93-5199-40c5-9771-61816c108d5b"
          }
        ],
        "partitions": [
          {
            "name": "Products",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Records = Table.FromRecords(Source),",
                "    Typed = Table.TransformColumnTypes(Records, {{\"Product ID\", Int64.Type}, {\"Brand\", type text}, {\"Product\", type text}, {\"Description\", type text}, {\"Ingredient count\", Int64.Type}, {\"Alcohol tag\", type text}, {\"Fragrance tag\", type text}, {\"Known active tag\", type text}, {\"Name review\", type text}, {\"Image available\", type text}, {\"Formula size\", type text}, {\"Product icon\", type text}}, \"en-US\")",
                "in",
